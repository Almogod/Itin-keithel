{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dev/layout,_N_T_/dev/routes/layout,_N_T_/dev/routes/page,_N_T_/dev/routes"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dev/routes/__PAGE__",
    "/dev/routes",
    "/dev",
    "/_index",
    "/_head"
  ]
}